# Environment / secrets — never commit real API keys or credentials.
# .env* (not *.env) is deliberate: *.env only matches names ENDING in
# .env, which misses timestamped backups like .env.backup.sqlite.<ts> —
# exactly the kind of file the DB migration created, containing the real
# Postgres connection string with password. Verified this gap existed
# 2026-08-11 before it could leak anything.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Runtime data — regenerable or local-only, not source code
psych-platform-core/qdrant_data/
psych-platform-core/*.sqlite
psych-platform-core/*.sqlite-journal
psych-platform-core/*.sqlite-shm
psych-platform-core/*.sqlite-wal
psych-platform-core/logs/
psych-platform-core/scratch/
*.log
server_err.txt
server_out.txt

# Large clinical/dataset source material — downloaded via scripts, not source code.
# See scripts/ingest.py, scripts/ingest_datasets.py, scripts/download_clinical_data.ps1
psych-platform-core/data/*.pdf
psych-platform-core/data/**/*.pdf
psych-platform-core/datasets/counselchat/counsel-chat/
psych-platform-core/datasets/ecc/ECC/
psych-platform-core/datasets/ecc/*.pdf
psych-platform-core/datasets/pysdial/PsyDial/
psych-platform-core/datasets/empathetic_dialogues/*.tar.gz
psych-platform-core/datasets/empathetic_dialogues/empatheticdialogues/*.csv

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Installer artifacts accidentally dropped in repo root
AzureCLI.msi
azurecli_install.log

# Clinical corpora — real consented, de-identified session transcripts
# (data/hinglish_sessions/) plus licensed/derived datasets and source PDFs.
# Deliberately NOT committed: this repository is public, and de-identified
# is not the same as non-sensitive — these contain passive suicidal-ideation
# content and a child safeguarding interview. Publishing them is effectively
# irreversible (forks, caches, scrapers), so the corpus is transferred to
# deployment targets out-of-band instead. ~92MB.
psych-platform-core/data/
