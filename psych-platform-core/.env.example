# ── AI Services ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_key         # optional; enables fast Groq path (~300ms)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/psych_db
# For local dev (SQLite, no Postgres required):
# DATABASE_URL=sqlite+aiosqlite:///./psych_db.sqlite

# Used only by docker-compose.yml to configure the postgres container and
# build DATABASE_URL for the app service — set a real password before running
# `docker compose up`. Not read directly by the app itself.
POSTGRES_USER=psych_admin
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=psych_db

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# ── Redis (rate limiting + shared RAG cache) ──────────────────────────────────
# Leave as memory:// for single-worker dev (no Redis required).
# Set to redis://127.0.0.1:6379/0 for production.
REDIS_URL=memory://

# ── Vector DB ─────────────────────────────────────────────────────────────────
VECTOR_DB_BACKEND=qdrant            # "qdrant" (local/server) or "pinecone"

# Qdrant — local file mode (default, single process only)
QDRANT_MODE=local
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=psych-brain

# Qdrant — server mode (Docker, multi-worker safe)
# QDRANT_MODE=server
# QDRANT_URL=http://127.0.0.1:6333
# Start with: docker run -d --name qdrant -p 6333:6333 -v %CD%\qdrant_data:/qdrant/storage qdrant/qdrant

# Pinecone (only needed when VECTOR_DB_BACKEND=pinecone)
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=psych-brain

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
